{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossplane-authz-lab.local/schemas/evidence.schema.json",
  "title": "Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id", "kind", "subject", "producer", "observed_at", "state_digest", "status"],
  "properties": {
    "evidence_id": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "minLength": 1},
    "producer": {"type": "string", "minLength": 1},
    "producer_version": {"type": "string"},
    "observed_at": {"type": "string", "format": "date-time"},
    "state_digest": {"type": "string", "minLength": 1},
    "status": {"enum": ["PASS", "FAIL", "UNKNOWN"]},
    "claims": {"type": "object"}
  }
}
